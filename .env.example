# Supabase
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Only needed for server-side/admin operations (Edge Functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payment (Razorpay — recommended for INR/UPI)
PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Payment (Stripe — for card/international)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Contact form → Google Sheet (Apps Script web app URL)
# See scripts/contact-sheet-apps-script.js for deploy steps
CONTACT_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
